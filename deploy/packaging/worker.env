# Deadfin transcode worker settings (docs/transcode-workers.md).
# After a change: systemctl restart deadfin-worker

# Base URL of the server, including any base path. Required.
DEADFIN_WORKER_SERVER=

# A static token (from DEADFIN_TRANSCODE_WORKER_TOKENS on the server) or a
# dashboard join token. The worker reads a join token only until it holds
# an identity in /var/lib/deadfin-worker.
DEADFIN_WORKER_TOKEN=

# Other flags, for example:
#   -max-jobs=3 -hw-type=qsv -render-node=/dev/dri/renderD128
#   -pool=qsv -input-mode=shared -path-map=/media=/mnt/media
DEADFIN_WORKER_ARGS=-max-jobs=1
